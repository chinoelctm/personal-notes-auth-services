<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- dotnet user-secrets: clave privada JWT y hash del usuario inicial fuera del repo en desarrollo -->
    <UserSecretsId>personal-notes-auth-services-5d27c4b9</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PersonalNotes.Auth.Application\PersonalNotes.Auth.Application.csproj" />
    <ProjectReference Include="..\PersonalNotes.Auth.Infrastructure\PersonalNotes.Auth.Infrastructure.csproj" />
  </ItemGroup>

</Project>
